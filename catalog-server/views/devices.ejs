<%- include('_layout_top') %>

<h3 style="margin-top:0;font-size:15px;">Enrolled devices</h3>
<table>
  <tr><th>Device UUID</th><th>Hostname</th><th>First seen</th><th>Last seen</th></tr>
  <% if (devices.length === 0) { %>
    <tr><td colspan="4" style="color:#9ca3af;">No devices have checked in yet.</td></tr>
  <% } %>
  <% devices.forEach(function(d) { %>
    <tr>
      <td style="font-family:monospace;font-size:11px;"><%= d.device_uuid %></td>
      <td><%= d.hostname %></td>
      <td><%= d.first_seen %></td>
      <td><%= d.last_seen %></td>
    </tr>
  <% }) %>
</table>

<%- include('_layout_bottom') %>
